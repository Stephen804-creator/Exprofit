# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
APP_NAME=Exprofit API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generate a unique random value of at least 32 bytes before use.
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long

# Local PostgreSQL. Replace the example password before use.
DATABASE_URL=postgresql+psycopg://exprofit:change-me@localhost:5432/exprofit

# Email verification delivery. Configure a real SMTP provider before enabling this flow.
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_MINUTES=30
WORKSPACE_INVITATION_TTL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
